rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function hasRole(role) {
      return isSignedIn() && (getUserData().role == role || request.auth.token.role == role);
    }

    function isAdmin() {
      return isSignedIn() && (hasRole('admin') || request.auth.token.admin == true || (request.auth.token.email == 'naolnigatu2025@gmail.com' && request.auth.token.email_verified == true));
    }

    function isStaff() {
      return isSignedIn() && (
        hasRole('admin') || 
        hasRole('reception') || 
        hasRole('kitchen') || 
        hasRole('waiter') || 
        hasRole('housekeeping')
      );
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'guest' ||
        (request.auth.token.email == 'naolnigatu2025@gmail.com' && request.auth.token.email_verified == true && request.resource.data.role == 'admin') ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        )
      );
      allow delete: if isAdmin();
    }

    // Staff collection
    match /staff/{staffId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Restaurant Orders
    match /restaurant_orders/{orderId} {
      allow create: if true; // Guests can place orders
      allow read: if true; // Public tracking & staff management
      allow update: if isStaff(); // Guests should not be able to arbitrarily modify their own order's total or status after submission
      allow delete: if isAdmin();
    }

    // Service Requests (Call Waiter, Bill Requests)
    match /service_requests/{requestId} {
      allow create: if true; // Guests can request service
      allow read: if true;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Restaurant Tables & Kitchen Stations
    match /restaurant_tables/{tableId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /kitchen_stations/{stationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App Settings & CMS Settings (restaurant, hotel, cms_*, etc.)
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact messages
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // Offers & Gallery & Announcements
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Menu items & Categories
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rooms & Categories
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /room_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings & Halls
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if true;
      allow update: if isStaff(); // Guests cannot modify payment status or totals directly
      allow delete: if isAdmin();
    }

    match /hall_requests/{requestId} {
      allow create: if true;
      allow read: if true;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    match /halls/{hallId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Housekeeping & Maintenance
    match /housekeeping_tasks/{taskId} {
      allow read, write: if isStaff();
    }

    match /maintenance_reports/{reportId} {
      allow read, write: if isStaff();
    }

    match /housekeeping_logs/{logId} {
      allow read, write: if isStaff();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow create: if isStaff() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow create: if isStaff() || (
        request.resource.data.type in ['booking', 'order', 'service'] &&
        request.resource.data.recipientRole in ['reception', 'kitchen', 'waiter'] &&
        (!('targetRoute' in request.resource.data) || request.resource.data.targetRoute in ['/admin/reservations', '/admin/kitchen', '/admin/waiter'])
      );
      allow read: if isStaff() || (resource.data.recipientUid == null || (isSignedIn() && resource.data.recipientUid == request.auth.uid));
      allow update: if isStaff() || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
      allow delete: if isStaff();
    }

    // CMS Collections
    match /cms_home/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_about/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_contact/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_footer/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_amenities/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_attractions/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_offers/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_policies/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_gallery/{docId} { allow read: if true; allow write: if isAdmin(); }
  }
}
