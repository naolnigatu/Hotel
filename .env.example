# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Direct / Pooler Database URL for Prisma ORM
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Resend Mail Services Configuration (Password reset, transactional notifications)
RESEND_API_KEY=re_your_resend_api_key_here
VITE_RESEND_API_KEY=re_your_resend_api_key_here
VITE_RESEND_FROM_EMAIL="Woliso Hotel <onboarding@resend.dev>"
